<Window x:Class="MyWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"  Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="58*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="54*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="71*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="133*"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="607*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="N_sqs_1_txt" Text="Введите число квадратов со стороной 1" TextWrapping="Wrap" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="0" />
        <TextBox x:Name="N_sqs_1_input" Grid.Column="1" Grid.Row="0"/>
        <TextBlock x:Name="N_sqs_2_txt" Text="Введите число квадратов со стороной 2" TextWrapping="Wrap" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="1" />
        <TextBox x:Name="N_sqs_2_input" Grid.Column="1" Grid.Row="1"/>
        <TextBlock x:Name="N_sqs_3_txt" Text="Введите число квадратов со стороной 3" TextWrapping="Wrap" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="2" />
        <TextBox x:Name="N_sqs_3_input" Grid.Column="1" Grid.Row="2"/>

        <Canvas Name="sq_dest" Background="White" Grid.Column="2" Grid.RowSpan="6"/>
        <ListBox Name="Squares" Grid.Row="6" Grid.Column="2" Grid.RowSpan="2" />

        <TextBlock x:Name="N_iterations" Text="Номер итерации:" TextWrapping="Wrap" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="4" />
        <TextBox Name="N_iterations_out"  Grid.Column="1" Grid.Row="4" />
        <TextBlock x:Name="Square_txt" Text="Площадь описывающего прямоугольника:" TextWrapping="Wrap" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="5" />
        <TextBox Name="Square_out" Grid.Column="1" Grid.Row="5" />
        

        <Button Name="Start_Button" Content="Запуск"  Grid.Row="7" Grid.Column="0" Click="Start_Button_Click"/>
        <Button Name="Stop_Button" Content="Стоп" Click="Stop_Button_Click"  Grid.Row="7" Grid.Column="1"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            
        </ScrollViewer>

        <TextBox Name ="Best_sol_out" Grid.Column="2" Grid.Row="6" Grid.RowSpan="2"/>
    </Grid>
</Window>
